    "text": "#f7f7f5",
    "text-muted": "#9a9aa5",
    "text-faint": "#6b6b76",
    "accent": "#ff5c38",
    "on-accent": "#0a0a0c",
    "success": "#7cffb2",
    "warning": "#ffc93c",
    "danger": "#ff5d5d"
